# Public Firebase WEB app configuration (not an Android application ID).
# Register a Web app within the existing voiceofprophecy Firebase project.
# Copy this file to .env.local and paste the Web app config from Firebase Console.
# NEVER place a service account, Admin SDK credential, secret or private key in VITE_*.
VITE_FIREBASE_PROJECT_ID=voiceofprophecy
VITE_FIREBASE_AUTH_DOMAIN=voiceofprophecy.firebaseapp.com
VITE_FIREBASE_API_KEY=AIzaSyCW4o_q47JSPFxX8NOcw89LlYHZKhIOAio
VITE_FIREBASE_APP_ID=1:895527572069:web:7ab4b8894a82529875ec8c

# Local Node API configuration (server-only; never prefix these with VITE_).
# Required for /api/study/progress and Admin/certificate API routes.
# A local clone can still create a basic student profile through Firestore
# without these values, but server-authoritative study writes need Admin SDK access.
FIREBASE_ADMIN_PROJECT_ID=voiceofprophecy
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-fbsvc@voiceofprophecy.iam.gserviceaccount.com
