# Public Firebase WEB app configuration (not an Android application ID).
# Register a Web app within the existing Firebase project.
# Copy this file to .env.local and fill in values from Firebase Console.
# NEVER place a service account, Admin SDK credential, secret or private key in VITE_*.
VITE_FIREBASE_PROJECT_ID=voiceofprophecy
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=

# Optional public native Android download/store URL shown on invitation pages.
# This must point to the native app, not the PWA.
VITE_ANDROID_DOWNLOAD_URL=

# Local Node API configuration (server-only; never prefix these with VITE_).
# Store the real values only in local/deployment secret storage; NEVER commit them.
FIREBASE_ADMIN_PROJECT_ID=voiceofprophecy
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Learning support automation
# Server-only. Store the real values in the deployment environment, never in Git.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=

# Payment providers
# Server-side Lenco token. Lenco documents this as the API token / API key / secret key.
# NEVER expose this with a VITE_ prefix.
LENCO_API_TOKEN=

# Lenco public checkout key. This is returned to the authenticated checkout UI
# only when a server-created transaction is ready to open the Lenco widget.
LENCO_PUBLIC_KEY=

# sandbox | production
LENCO_ENVIRONMENT=sandbox

# CRON_SECRET is also used to protect scheduled payment reconciliation.
# Keep the same deployment secret used by existing scheduled server jobs.

# Direct MTN MoMo Collections
# Sandbox API user/API key are generated programmatically; they are not shown
# on the MoMo portal. Run: npm run payments:mtn:provision-sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=https://vopafrica.vercel.app/api/payments/webhooks/mtn-momo
# Sandbox defaults to https://sandbox.momodeveloper.mtn.com.
# For production, set the base URL supplied during MTN onboarding.
MTN_MOMO_BASE_URL=

# Direct Airtel Money Zambia Collections
# Obtain client credentials and callback configuration from the Airtel developer portal.
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_ENVIRONMENT=staging
AIRTEL_MONEY_COUNTRY=ZM
AIRTEL_MONEY_CURRENCY=ZMW
# Optional override. Defaults to Airtel's staging/production OpenAPI hosts.
AIRTEL_MONEY_BASE_URL=
# Defaults below match the direct collection/enquiry contract used by the adapter.
AIRTEL_MONEY_COLLECTION_PATH=/merchant/v1/payments/
AIRTEL_MONEY_STATUS_PATH_PREFIX=/standard/v1/payments/
# If Airtel is configured to send an Authorization header to callbacks, store
# the exact expected header value here. It stays server-only.
AIRTEL_MONEY_CALLBACK_AUTHORIZATION=
