rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasUserProfile()
        ? userDoc().data.get('role', 'student')
        : 'student';
    }

    function isSuperAdmin() {
      return signedIn() && role() == 'super_admin';
    }

    function isAdmin() {
      return signedIn() && role() in [
        'super_admin',
        'union_admin',
        'conference_admin',
        'district_admin',
        'church_admin'
      ];
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function canEditCurriculum() {
      return isAdmin() && (
        role() == 'super_admin' ||
        userDoc().data.get('privileges', {}).get('editor', false) == true
      );
    }

    function validProgress(uid) {
      let d = request.resource.data;

      return d.keys().hasAll([
          'ownerUid',
          'language',
          'lessonId',
          'revision',
          'answers',
          'practiceScore',
          'status',
          'submittedAt'
        ])
        && d.keys().hasOnly([
          'ownerUid',
          'language',
          'lessonId',
          'revision',
          'answers',
          'practiceScore',
          'status',
          'submittedAt'
        ])
        && d.ownerUid == uid
        && d.language is string
        && d.language.matches('[a-z]{2,3}(-[a-z0-9]{2,8})*')
        && d.lessonId is string
        && d.lessonId.matches('[A-Za-z0-9_-]{1,80}')
        && d.revision is string
        && d.revision.matches('[a-f0-9]{64}')
        && d.status == 'practice_unverified'
        && d.practiceScore is number
        && d.practiceScore >= 0
        && d.practiceScore <= 100
        && d.answers is list
        && d.answers.size() == 5
        && d.answers[0] is int
        && d.answers[0] >= 0
        && d.answers[0] <= 5
        && d.answers[1] is int
        && d.answers[1] >= 0
        && d.answers[1] <= 5
        && d.answers[2] is int
        && d.answers[2] >= 0
        && d.answers[2] <= 5
        && d.answers[3] is int
        && d.answers[3] >= 0
        && d.answers[3] <= 5
        && d.answers[4] is int
        && d.answers[4] >= 0
        && d.answers[4] <= 5
        && d.submittedAt == request.time;
    }

    function canCreateOwnProfile() {
      return signedIn()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.get('role', 'student') == 'student';
    }

    function canUpdateOwnProfile() {
      return signedIn()
        && request.auth.uid == resource.data.uid
        && request.resource.data.get('role', 'student')
            == resource.data.get('role', 'student')
        && request.resource.data.get('adminNodeType', null)
            == resource.data.get('adminNodeType', null)
        && request.resource.data.get('adminNodeId', null)
            == resource.data.get('adminNodeId', null)
        && request.resource.data.get('privileges', {})
            == resource.data.get('privileges', {})
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'phoneNumber',
            'photoURL',
            'information',
            'preferences',
            'updatedAt'
          ]);
    }

    function unionAdminForCreateUpdate() {
      return role() == 'union_admin'
        && request.resource.data.get('unionId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    function unionAdminForDelete() {
      return role() == 'union_admin'
        && resource.data.get('unionId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    function conferenceAdminForCreateUpdate() {
      return role() == 'conference_admin'
        && request.resource.data.get('conferenceId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    function conferenceAdminForDelete() {
      return role() == 'conference_admin'
        && resource.data.get('conferenceId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    function districtAdminForCreateUpdate() {
      return role() == 'district_admin'
        && request.resource.data.get('districtId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    function districtAdminForDelete() {
      return role() == 'district_admin'
        && resource.data.get('districtId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    // Public application configuration.
    match /system/settings {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    // Certification is public only when explicitly enabled.
    match /system/certification {
      allow get: if resource.data.enabled == true;
      allow list: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    // Public languages are enabled languages only.
    match /languages/{languageId} {
      allow get, list: if isAdmin() || resource.data.enabled == true;
      allow create, update, delete: if isAdmin();
    }

    // Translation configuration is public.
    match /translations/{language} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public announcements are published only.
    match /announcements/{id} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Public learning materials are published only.
    match /books/{id} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Public radio broadcasts are published only.
    match /radioBroadcasts/{id} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Organization reference data.
    match /unions/{id} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /conferences/{id} {
      allow get, list: if true;
      allow create, update: if isSuperAdmin() || unionAdminForCreateUpdate();
      allow delete: if isSuperAdmin() || unionAdminForDelete();
    }

    match /districts/{id} {
      allow get, list: if true;
      allow create, update: if isSuperAdmin() || conferenceAdminForCreateUpdate();
      allow delete: if isSuperAdmin() || conferenceAdminForDelete();
    }

    match /churches/{id} {
      allow get, list: if true;
      allow create, update: if isSuperAdmin() || districtAdminForCreateUpdate();
      allow delete: if isSuperAdmin() || districtAdminForDelete();
    }

    // Canonical Discover guide metadata.
    // A guide is visible to learners only after the admin explicitly publishes it.
    match /curricula/discover/languages/{language} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.published == true && resource.data.archived != true);
      allow create, update, delete: if canEditCurriculum();
    }

    // Canonical approved VOP Discover lesson path.
    match /curricula/discover/languages/{language}/lessons/{lessonId} {
      allow get, list: if signedIn();
      allow create, update, delete: if canEditCurriculum();
    }

    // Collection-group queries over all VOP lesson subcollections.
    match /{path=**}/lessons/{lessonId} {
      allow get, list: if signedIn();
      allow create, update, delete: if canEditCurriculum();
    }

    // Legacy/alternate top-level curriculum documents, if present.
    // Public access requires explicit publication.
    match /curriculum/{guideId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if canEditCurriculum();
    }

    // User profiles.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if canCreateOwnProfile();
      allow update: if isSuperAdmin() || canUpdateOwnProfile();
      allow delete: if isSuperAdmin();

      match /progress/{recordId} {
        allow get, list: if signedIn()
          && (request.auth.uid == uid || isAdmin());

        allow create: if isOwner(uid)
          && recordId == uid
          && validProgress(uid);

        allow update, delete: if false;
      }
    }

    // Prayer requests remain private to their candidate and administrators.
    match /prayerRequests/{id} {
      allow get: if signedIn()
        && (
          resource.data.candidateId == request.auth.uid
          || isAdmin()
        );

      allow list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.candidateId == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.candidateId == request.auth.uid
          || isAdmin()
        );

      allow delete: if isSuperAdmin();
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
