rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasUserProfile()
        ? userDoc().data.get('role', 'student')
        : 'student';
    }

    function isSuperAdmin() {
      return signedIn() && role() == 'super_admin';
    }

    function isAdmin() {
      return isSuperAdmin()
        || isOrganizationAdmin(organizationIdForUser())
        || isHierarchyTenant();
    }

    function organizationIdForUser() {
      return hasUserProfile() ? userDoc().data.get('organizationId', '') : '';
    }

    function isOrgMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('active', false) == true;
    }

    function orgRole(orgId) {
      return isOrgMember(orgId)
        ? get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', 'viewer')
        : '';
    }

    function canManageOrg(orgId) {
      return isSuperAdmin() || (
        isOrgMember(orgId)
        && orgRole(orgId) in ['owner', 'admin']
      ) || hierarchyOrganizationScope(orgId);
    }

    function validOrganizationMemberData(data, organizationId) {
      return data.get('uid', '') is string
        && data.get('uid', '') != ''
        && data.get('organizationId', '') == organizationId
        && data.get('role', '') in ['owner', 'admin', 'editor', 'mentor', 'teacher', 'learner', 'viewer']
        && data.get('active', false) is bool;
    }

    function isOrganizationAdmin(orgId) {
      return isSuperAdmin() || (
        isOrgMember(orgId)
        && orgRole(orgId) in ['owner', 'admin']
      );
    }

    function canEditOrgContent(orgId) {
      return isSuperAdmin() || (
        isOrgMember(orgId)
        && orgRole(orgId) in ['owner', 'admin', 'editor']
      ) || hierarchyOrganizationScope(orgId);
    }

    function orgDataMatches(orgId, data) {
      return data.get('organizationId', '') == orgId
        || data.get('ownerOrganizationId', '') == orgId;
    }

    function canEditOwnedContent(data) {
      return isSuperAdmin()
        || (
          isOrgMember(organizationIdForUser())
          && data.get('organizationId', data.get('ownerOrganizationId', '')) == organizationIdForUser()
          && data.get('ownerUid', '') == request.auth.uid
          && orgRole(organizationIdForUser()) in ['owner', 'admin', 'editor']
        )
        || (
          isHierarchyTenant()
          && data.get('organizationId', data.get('ownerOrganizationId', '')) != ''
          && hierarchyOrganizationScope(data.get('organizationId', data.get('ownerOrganizationId', '')))
          && data.get('ownerTenantId', '') == hierarchyTenantId()
          && data.get('ownerUid', '') == request.auth.uid
        );
    }

    function isHierarchyTenant() {
      return signedIn() && role() in ['union_admin','conference_admin','district_admin','church_admin']
        && userDoc().data.get('adminNodeId', '') != '';
    }

    function hierarchyTenantId() {
      return role() + ':' + userDoc().data.get('adminNodeId', '');
    }

    function hierarchyOrganizationScope(organizationId) {
      return isHierarchyTenant()
        && organizationId != ''
        && exists(/databases/$(database)/documents/organizations/$(organizationId))
        && (
          (role() == 'union_admin'
            && (
              get(/databases/$(database)/documents/organizations/$(organizationId)).data.get('unionId', '') == userDoc().data.get('adminNodeId', '')
              || get(/databases/$(database)/documents/organizations/$(organizationId)).data.get('hierarchy', {}).get('unionId', '') == userDoc().data.get('adminNodeId', '')
            ))
          || (role() == 'conference_admin'
            && (
              get(/databases/$(database)/documents/organizations/$(organizationId)).data.get('conferenceId', '') == userDoc().data.get('adminNodeId', '')
              || get(/databases/$(database)/documents/organizations/$(organizationId)).data.get('hierarchy', {}).get('conferenceId', '') == userDoc().data.get('adminNodeId', '')
            ))
          || (role() == 'district_admin'
            && (
              get(/databases/$(database)/documents/organizations/$(organizationId)).data.get('districtId', '') == userDoc().data.get('adminNodeId', '')
              || get(/databases/$(database)/documents/organizations/$(organizationId)).data.get('hierarchy', {}).get('districtId', '') == userDoc().data.get('adminNodeId', '')
            ))
          || (role() == 'church_admin'
            && (
              get(/databases/$(database)/documents/organizations/$(organizationId)).data.get('churchId', '') == userDoc().data.get('adminNodeId', '')
              || get(/databases/$(database)/documents/organizations/$(organizationId)).data.get('hierarchy', {}).get('churchId', '') == userDoc().data.get('adminNodeId', '')
            ))
        );
    }

    function canEditOwnedGlobal(data) {
      return isSuperAdmin()
        || (
          signedIn()
          && data.get('ownerUid', '') == request.auth.uid
          && isOrgMember(organizationIdForUser())
          && orgRole(organizationIdForUser()) in ['owner', 'admin', 'editor']
        )
        || (
          isHierarchyTenant()
          && data.get('ownerUid', '') == request.auth.uid
          && data.get('ownerTenantId', '') == hierarchyTenantId()
        );
    }

    function canReadGlobal(data, publishedField) {
      return isSuperAdmin()
        || (isOrgMember(organizationIdForUser()) && data.get('organizationId', '') == organizationIdForUser())
        || (isHierarchyTenant())
        || (data.get('sharingScope', 'private') == 'shared' && data.get(publishedField, false) == true)
        || (data.get('organizationId', '') == '' && data.get(publishedField, false) == true);
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function canEditCurriculum() {
      return isAdmin() && (
        role() == 'super_admin' ||
        userDoc().data.get('privileges', {}).get('editor', false) == true
      );
    }

    function validProgress(uid) {
      let d = request.resource.data;

      return d.keys().hasAll([
          'ownerUid',
          'language',
          'lessonId',
          'revision',
          'answers',
          'practiceScore',
          'status',
          'submittedAt'
        ])
        && d.keys().hasOnly([
          'ownerUid',
          'language',
          'lessonId',
          'revision',
          'answers',
          'practiceScore',
          'status',
          'submittedAt'
        ])
        && d.ownerUid == uid
        && d.language is string
        && d.language.matches('[a-z]{2,3}(-[a-z0-9]{2,8})*')
        && d.lessonId is string
        && d.lessonId.matches('[A-Za-z0-9_-]{1,80}')
        && d.revision is string
        && d.revision.matches('[a-f0-9]{64}')
        && d.status == 'practice_unverified'
        && d.practiceScore is number
        && d.practiceScore >= 0
        && d.practiceScore <= 100
        && d.answers is list
        && d.answers.size() == 5
        && d.answers[0] is int
        && d.answers[0] >= 0
        && d.answers[0] <= 5
        && d.answers[1] is int
        && d.answers[1] >= 0
        && d.answers[1] <= 5
        && d.answers[2] is int
        && d.answers[2] >= 0
        && d.answers[2] <= 5
        && d.answers[3] is int
        && d.answers[3] >= 0
        && d.answers[3] <= 5
        && d.answers[4] is int
        && d.answers[4] >= 0
        && d.answers[4] <= 5
        && d.submittedAt == request.time;
    }

    function canCreateOwnProfile() {
      return signedIn()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.get('role', 'student') == 'student';
    }

    function canUpdateOwnProfile() {
      return signedIn()
        && request.auth.uid == resource.data.uid
        && request.resource.data.get('role', 'student')
            == resource.data.get('role', 'student')
        && request.resource.data.get('adminNodeType', null)
            == resource.data.get('adminNodeType', null)
        && request.resource.data.get('adminNodeId', null)
            == resource.data.get('adminNodeId', null)
        && request.resource.data.get('privileges', {})
            == resource.data.get('privileges', {})
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'phoneNumber',
            'photoURL',
            'information',
            'preferences',
            'updatedAt'
          ]);
    }

    function unionAdminForCreateUpdate(collectionName, recordId) {
      return role() == 'union_admin'
        && (
          (collectionName == 'unions' && recordId == userDoc().data.get('adminNodeId', ''))
          || (collectionName in ['conferences','districts','churches']
              && (
                request.resource.data.get('unionId', '') == userDoc().data.get('adminNodeId', '')
                || (request.method == 'update' && resource.data.get('unionId', '') == userDoc().data.get('adminNodeId', ''))
              ))
        );
    }

    function unionAdminForDelete(collectionName, recordId) {
      return role() == 'union_admin'
        && (
          (collectionName == 'unions' && recordId == userDoc().data.get('adminNodeId', ''))
          || (collectionName in ['conferences','districts','churches']
              && resource.data.get('unionId', '') == userDoc().data.get('adminNodeId', ''))
        );
    }

    function conferenceAdminForCreateUpdate(collectionName, recordId) {
      return role() == 'conference_admin'
        && (
          (collectionName == 'conferences' && recordId == userDoc().data.get('adminNodeId', ''))
          || (collectionName in ['districts','churches']
              && (
                request.resource.data.get('conferenceId', '') == userDoc().data.get('adminNodeId', '')
                || (request.method == 'update' && resource.data.get('conferenceId', '') == userDoc().data.get('adminNodeId', ''))
              ))
        );
    }

    function conferenceAdminForDelete(collectionName, recordId) {
      return role() == 'conference_admin'
        && (
          (collectionName == 'conferences' && recordId == userDoc().data.get('adminNodeId', ''))
          || (collectionName in ['districts','churches']
              && resource.data.get('conferenceId', '') == userDoc().data.get('adminNodeId', ''))
        );
    }

    function districtAdminForCreateUpdate(collectionName, recordId) {
      return role() == 'district_admin'
        && (
          (collectionName == 'districts' && recordId == userDoc().data.get('adminNodeId', ''))
          || (collectionName == 'churches'
              && (
                request.resource.data.get('districtId', '') == userDoc().data.get('adminNodeId', '')
                || (request.method == 'update' && resource.data.get('districtId', '') == userDoc().data.get('adminNodeId', ''))
              ))
        );
    }

    function districtAdminForDelete(collectionName, recordId) {
      return role() == 'district_admin'
        && (
          (collectionName == 'districts' && recordId == userDoc().data.get('adminNodeId', ''))
          || (collectionName == 'churches'
              && resource.data.get('districtId', '') == userDoc().data.get('adminNodeId', ''))
        );
    }

    function hierarchyTenantForField(data, fieldName) {
      return signedIn()
        && role() in ['union_admin','conference_admin','district_admin','church_admin']
        && data.get(fieldName, '') == userDoc().data.get('adminNodeId', '');
    }

    function userHierarchyRecordScope(collectionName, recordId, data) {
      return signedIn()
        && (
          (collectionName == 'unions' && (
            recordId == userDoc().data.get('unionId', '')
            || data.get('id', '') == userDoc().data.get('unionId', '')
          ))
          || (collectionName == 'conferences' && (
            recordId == userDoc().data.get('conferenceId', '')
            || data.get('id', '') == userDoc().data.get('conferenceId', '')
          ))
          || (collectionName == 'districts' && (
            recordId == userDoc().data.get('districtId', '')
            || data.get('id', '') == userDoc().data.get('districtId', '')
          ))
          || (collectionName == 'churches' && (
            recordId == userDoc().data.get('churchId', '')
            || data.get('id', '') == userDoc().data.get('churchId', '')
          ))
          || (
            isOrgMember(organizationIdForUser())
            && exists(/databases/$(database)/documents/organizations/$(organizationIdForUser()))
            && (
              (collectionName == 'unions' && data.get('id', '') == get(/databases/$(database)/documents/organizations/$(organizationIdForUser())).data.get('unionId', ''))
              || (collectionName == 'conferences' && data.get('id', '') == get(/databases/$(database)/documents/organizations/$(organizationIdForUser())).data.get('conferenceId', ''))
              || (collectionName == 'districts' && data.get('id', '') == get(/databases/$(database)/documents/organizations/$(organizationIdForUser())).data.get('districtId', ''))
              || (collectionName == 'churches' && data.get('id', '') == get(/databases/$(database)/documents/organizations/$(organizationIdForUser())).data.get('churchId', ''))
            )
          )
        );
    }

    function canReadHierarchyRecord(collectionName, recordId, data) {
      return isSuperAdmin()
        || userHierarchyRecordScope(collectionName, recordId, data)
        || (
          isHierarchyTenant()
          && (
            (role() == 'union_admin' && (
              (collectionName == 'unions' && recordId == userDoc().data.get('adminNodeId', ''))
              || (collectionName in ['conferences','districts','churches'] && data.get('unionId', '') == userDoc().data.get('adminNodeId', ''))
            ))
            || (role() == 'conference_admin' && (
              (collectionName == 'conferences' && recordId == userDoc().data.get('adminNodeId', ''))
              || (collectionName in ['districts','churches'] && data.get('conferenceId', '') == userDoc().data.get('adminNodeId', ''))
            ))
            || (role() == 'district_admin' && (
              (collectionName == 'districts' && recordId == userDoc().data.get('adminNodeId', ''))
              || (collectionName == 'churches' && data.get('districtId', '') == userDoc().data.get('adminNodeId', ''))
            ))
            || (role() == 'church_admin' && collectionName == 'churches' && recordId == userDoc().data.get('adminNodeId', ''))
          )
        );
    }

    function canViewHierarchyCertificate(data) {
      return hierarchyTenantForField(data, 'unionId')
        || hierarchyTenantForField(data, 'conferenceId')
        || hierarchyTenantForField(data, 'districtId')
        || hierarchyTenantForField(data, 'churchId')
        || hierarchyOrganizationScope(data.get('organizationId', ''));
    }

    function canManageHierarchyUser(data) {
      return hierarchyTenantForField(data, 'unionId')
        || hierarchyTenantForField(data, 'conferenceId')
        || hierarchyTenantForField(data, 'districtId')
        || hierarchyTenantForField(data, 'churchId')
        || hierarchyOrganizationScope(data.get('organizationId', ''));
    }

    // Platform configuration remains controlled by the VOP Super Admin.
    match /system/settings {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    match /system/permissions {
      allow get: if isSuperAdmin();
      allow list: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    match /tenantSettings/{tenantId}/settings/{settingId} {
      allow get: if isHierarchyTenant() && tenantId == hierarchyTenantId();
      allow list: if false;
      allow create, update, delete: if isHierarchyTenant() && tenantId == hierarchyTenantId();
    }

    // First-class SaaS organizations and memberships.
    match /organizations/{organizationId} {
      allow get: if isSuperAdmin() || isOrgMember(organizationId);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || canManageOrg(organizationId);
      allow delete: if isSuperAdmin();

      match /members/{uid} {
        allow get: if isSuperAdmin() || canManageOrg(organizationId) || (uid == request.auth.uid && (organizationId == organizationIdForUser() || hierarchyOrganizationScope(organizationId)));
        allow list: if isSuperAdmin() || canManageOrg(organizationId);

        // Membership is an authorization record. Non-platform administrators may
        // manage non-owner members, but cannot create an owner, change the tenant
        // identifier, or modify their own membership directly from the client.
        // The server-side organization API performs the coordinated membership +
        // user-profile + Auth-claim update for assignment/removal.
        allow create: if isSuperAdmin()
          || (
            canManageOrg(organizationId)
            && uid != request.auth.uid
            && request.resource.data.get('uid', '') == uid
            && validOrganizationMemberData(request.resource.data, organizationId)
            && request.resource.data.get('role', '') != 'owner'
            && get(/databases/$(database)/documents/users/$(uid)).data.get('organizationId', '') == organizationId
            && get(/databases/$(database)/documents/users/$(uid)).data.get('organizationRole', '') == request.resource.data.get('role', '')
          );

        allow update: if isSuperAdmin()
          || (
            canManageOrg(organizationId)
            && uid != request.auth.uid
            && validOrganizationMemberData(resource.data, organizationId)
            && validOrganizationMemberData(request.resource.data, organizationId)
            && resource.data.get('role', '') != 'owner'
            && request.resource.data.get('role', '') != 'owner'
            && request.resource.data.get('organizationId', '') == resource.data.get('organizationId', '')
            && request.resource.data.get('uid', '') == resource.data.get('uid', '')
            && get(/databases/$(database)/documents/users/$(uid)).data.get('organizationId', '') == organizationId
            && get(/databases/$(database)/documents/users/$(uid)).data.get('organizationRole', '') == request.resource.data.get('role', '')
          );

        // Removal must go through the canonical server API so the user's profile
        // and authentication claims are cleared atomically with the membership.
        allow delete: if isSuperAdmin();
      }

      match /settings/{settingId} {
        allow get: if isSuperAdmin() || isOrgMember(organizationId);
        allow list: if false;
        allow create, update, delete: if canManageOrg(organizationId);
      }

      match /audit/{entryId} {
        allow get, list: if isSuperAdmin() || canManageOrg(organizationId);
        allow create: if isSuperAdmin() || isOrgMember(organizationId);
        allow update, delete: if false;
      }
    }

    // Tenant-owned guides and lessons. Canonical editing never transfers through sharing.
    match /guides/{guideId} {
      allow get: if isSuperAdmin()
        || (isOrgMember(resource.data.organizationId) && resource.data.get('organizationId','') == organizationIdForUser())
        || (resource.data.get('sharingScope','private') == 'shared' && resource.data.get('published',false) == true);
      allow list: if isSuperAdmin()
        || (isOrgMember(organizationIdForUser()) && resource.data.get('organizationId','') == organizationIdForUser())
        || (resource.data.get('sharingScope','private') == 'shared' && resource.data.get('published',false) == true);
      allow create: if isSuperAdmin() || (
        request.resource.data.get('organizationId','') == organizationIdForUser()
        && canEditOrgContent(organizationIdForUser())
      );
      allow update, delete: if isSuperAdmin() || (
        canEditOwnedContent(resource.data)
        && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
        && request.resource.data.get('ownerOrganizationId','') == resource.data.get('ownerOrganizationId','')
        && request.resource.data.get('ownerUid','') == resource.data.get('ownerUid','')
        && request.resource.data.get('canonical',true) == resource.data.get('canonical',true)
      );

      match /lessons/{lessonId} {
        allow get: if isSuperAdmin()
          || (isOrgMember(organizationIdForUser()) && get(/databases/$(database)/documents/guides/$(guideId)).data.get('organizationId','') == organizationIdForUser())
          || (get(/databases/$(database)/documents/guides/$(guideId)).data.get('sharingScope','private') == 'shared'
              && get(/databases/$(database)/documents/guides/$(guideId)).data.get('published',false) == true
              && resource.data.get('sharingScope','shared') == 'shared'
              && resource.data.get('published',false) == true);
        allow list: if isSuperAdmin()
          || (isOrgMember(organizationIdForUser()) && get(/databases/$(database)/documents/guides/$(guideId)).data.get('organizationId','') == organizationIdForUser())
          || (get(/databases/$(database)/documents/guides/$(guideId)).data.get('sharingScope','private') == 'shared'
              && get(/databases/$(database)/documents/guides/$(guideId)).data.get('published',false) == true
              && resource.data.get('sharingScope','shared') == 'shared'
              && resource.data.get('published',false) == true);
        allow create: if isSuperAdmin() || (
          get(/databases/$(database)/documents/guides/$(guideId)).data.get('organizationId','') == organizationIdForUser()
          && canEditOrgContent(organizationIdForUser())
          && request.resource.data.get('ownerOrganizationId','') == organizationIdForUser()
        );
        allow update, delete: if isSuperAdmin() || (
          get(/databases/$(database)/documents/guides/$(guideId)).data.get('organizationId','') == organizationIdForUser()
          && canEditOwnedContent(resource.data)
          && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
          && request.resource.data.get('ownerOrganizationId','') == resource.data.get('ownerOrganizationId','')
          && request.resource.data.get('ownerUid','') == resource.data.get('ownerUid','')
          && request.resource.data.get('canonical',true) == resource.data.get('canonical',true)
        );
      }
    }

    // Reusable quiz library.
    match /quizzes/{quizId} {
      allow get: if isSuperAdmin()
        || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser()))
        || (resource.data.get('sharingScope','private') == 'shared' && resource.data.get('published',false) == true);
      allow list: if isSuperAdmin()
        || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser()))
        || (resource.data.get('sharingScope','private') == 'shared' && resource.data.get('published',false) == true);
      allow create: if isSuperAdmin() || (
        canEditOrgContent(request.resource.data.get('organizationId',''))
        && request.resource.data.get('ownerOrganizationId','') == request.resource.data.get('organizationId','')
      );
      allow update, delete: if isSuperAdmin() || (
        canEditOwnedContent(resource.data)
        && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
        && request.resource.data.get('ownerOrganizationId','') == resource.data.get('ownerOrganizationId','')
        && request.resource.data.get('ownerUid','') == resource.data.get('ownerUid','')
        && request.resource.data.get('canonical',true) == resource.data.get('canonical',true)
      );
    }

    match /candidates/{id} {
      allow get, list: if isSuperAdmin()
        || canManageOrg(resource.data.get('organizationId',''));
      allow create: if isSuperAdmin()
        || canManageOrg(request.resource.data.get('organizationId',''));
      allow update, delete: if isSuperAdmin() || (
        canManageOrg(resource.data.get('organizationId',''))
        && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
      );
    }

    // Tenant-owned operational records. Published shared records remain publicly readable.
    match /announcements/{id} {
      allow get, list: if canReadGlobal(resource.data, 'published')
        || canManageOrg(resource.data.get('organizationId',''));
      allow create: if isSuperAdmin()
        || (
          canManageOrg(request.resource.data.get('organizationId',''))
          && request.resource.data.get('ownerUid','') == request.auth.uid
        );
      allow update, delete: if isSuperAdmin() || (
        canEditOwnedContent(resource.data)
        && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
        && request.resource.data.get('ownerOrganizationId','') == resource.data.get('ownerOrganizationId','')
        && request.resource.data.get('ownerUid','') == resource.data.get('ownerUid','')
      );
    }

    match /books/{id} {
      allow get, list: if isSuperAdmin()
        || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser()))
        || ((resource.data.get('sharingScope','private') == 'shared' && resource.data.get('published',false) == true)
            || (resource.data.get('organizationId','') == '' && resource.data.get('published',false) == true));
      allow create: if isSuperAdmin() || (
        (
          isOrgMember(organizationIdForUser())
          && request.resource.data.get('ownerUid','') == request.auth.uid
          && request.resource.data.get('organizationId','') in ['', organizationIdForUser()]
          && orgRole(organizationIdForUser()) in ['owner', 'admin', 'editor']
        )
        || (
          isHierarchyTenant()
          && request.resource.data.get('ownerUid','') == request.auth.uid
          && request.resource.data.get('ownerTenantId','') == hierarchyTenantId()
          && request.resource.data.get('organizationId','') == ''
        )
      );
      allow update, delete: if isSuperAdmin() || (
        canEditOwnedGlobal(resource.data)
        && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
        && request.resource.data.get('ownerUid','') == resource.data.get('ownerUid','')
      );
    }

    match /radioBroadcasts/{id} {
      allow get, list: if isSuperAdmin()
        || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser()))
        || ((resource.data.get('sharingScope','private') == 'shared' && resource.data.get('published',false) == true)
            || (resource.data.get('organizationId','') == '' && resource.data.get('published',false) == true));
      allow create: if isSuperAdmin() || (
        (
          isOrgMember(organizationIdForUser())
          && request.resource.data.get('ownerUid','') == request.auth.uid
          && request.resource.data.get('organizationId','') in ['', organizationIdForUser()]
          && orgRole(organizationIdForUser()) in ['owner', 'admin', 'editor']
        )
        || (
          isHierarchyTenant()
          && request.resource.data.get('ownerUid','') == request.auth.uid
          && request.resource.data.get('ownerTenantId','') == hierarchyTenantId()
          && request.resource.data.get('organizationId','') == ''
        )
      );
      allow update, delete: if isSuperAdmin() || (
        canEditOwnedGlobal(resource.data)
        && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
        && request.resource.data.get('ownerUid','') == resource.data.get('ownerUid','')
      );
    }

    match /playlists/{id} {
      allow get, list: if isSuperAdmin()
        || (resource.data.get('ownerUid','') == request.auth.uid && isOrgMember(organizationIdForUser()))
        || (resource.data.get('sharingScope','private') == 'shared' && resource.data.get('published',false) == true)
        || (resource.data.get('organizationId','') == '' && resource.data.get('published',false) == true);
      allow create: if isSuperAdmin() || (
        isOrgMember(organizationIdForUser())
        && request.resource.data.get('ownerUid','') == request.auth.uid
        && request.resource.data.get('organizationId','') == ''
        && orgRole(organizationIdForUser()) in ['owner', 'admin', 'editor']
      );
      allow update, delete: if isSuperAdmin() || (
        canEditOwnedGlobal(resource.data)
        && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
        && request.resource.data.get('ownerUid','') == resource.data.get('ownerUid','')
      );
    }

    match /languages/{languageId} {
      allow get, list: if canReadGlobal(resource.data, 'enabled');
      allow create: if isSuperAdmin() || (
        (
          isOrgMember(organizationIdForUser())
          && request.resource.data.get('ownerUid','') == request.auth.uid
          && request.resource.data.get('organizationId','') in ['', organizationIdForUser()]
          && orgRole(organizationIdForUser()) in ['owner', 'admin', 'editor']
        )
        || (
          isHierarchyTenant()
          && request.resource.data.get('ownerUid','') == request.auth.uid
          && request.resource.data.get('ownerTenantId','') == hierarchyTenantId()
          && request.resource.data.get('organizationId','') == ''
        )
      );
      allow update, delete: if isSuperAdmin() || (
        canEditOwnedGlobal(resource.data)
        && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
        && request.resource.data.get('ownerUid','') == resource.data.get('ownerUid','')
      );
    }

    match /translations/{languageId} {
      allow get, list: if isSuperAdmin()
        || (isOrgMember(organizationIdForUser()) && resource.data.get('organizationId','') == organizationIdForUser())
        || isHierarchyTenant()
        || resource.data.get('sharingScope','private') == 'shared';
      allow create: if isSuperAdmin() || (
        (
          isOrgMember(organizationIdForUser())
          && request.resource.data.get('ownerUid','') == request.auth.uid
          && request.resource.data.get('organizationId','') in ['', organizationIdForUser()]
          && orgRole(organizationIdForUser()) in ['owner', 'admin', 'editor']
        )
        || (
          isHierarchyTenant()
          && request.resource.data.get('ownerUid','') == request.auth.uid
          && request.resource.data.get('ownerTenantId','') == hierarchyTenantId()
          && request.resource.data.get('organizationId','') == ''
        )
      );
      allow update, delete: if isSuperAdmin() || (
        canEditOwnedGlobal(resource.data)
        && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
        && request.resource.data.get('ownerUid','') == resource.data.get('ownerUid','')
      );
    }

    // Platform certification configuration.
    // Canonical translations remain immutable to non-owners. Contributors who
    // do not own a translation submit a proposal for review instead of overwriting it.
    match /translations/{languageId}/proposals/{proposalId} {
      allow get, list: if isSuperAdmin()
        || (signedIn() && resource.data.get('proposerUid', '') == request.auth.uid)
        || (isAdmin() && resource.data.get('organizationId', '') == organizationIdForUser());
      allow create: if isAdmin()
        && isOrgMember(organizationIdForUser())
        && request.resource.data.get('proposerUid', '') == request.auth.uid
        && request.resource.data.get('proposerOrganizationId', '') == organizationIdForUser()
        && request.resource.data.get('organizationId', '') == organizationIdForUser()
        && request.resource.data.get('status', 'pending') == 'pending';
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /system/certification {
      allow get: if resource.data.get('enabled', false) == true || isSuperAdmin();
      allow list: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    // Organization reference data remains platform-managed.
    match /unions/{id} {
      allow get, list: if canReadHierarchyRecord('unions', id, resource.data);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || unionAdminForCreateUpdate('unions', id);
    }
    match /conferences/{id} {
      allow get, list: if canReadHierarchyRecord('conferences', id, resource.data);
      allow create, update: if isSuperAdmin()
        || unionAdminForCreateUpdate('conferences', id)
        || conferenceAdminForCreateUpdate('conferences', id);
      allow delete: if isSuperAdmin()
        || unionAdminForDelete('conferences', id)
        || conferenceAdminForDelete('conferences', id);
    }
    match /districts/{id} {
      allow get, list: if canReadHierarchyRecord('districts', id, resource.data);
      allow create, update: if isSuperAdmin()
        || unionAdminForCreateUpdate('districts', id)
        || conferenceAdminForCreateUpdate('districts', id);
      allow delete: if isSuperAdmin()
        || unionAdminForDelete('districts', id)
        || conferenceAdminForDelete('districts', id);
    }
    match /churches/{id} {
      allow get, list: if canReadHierarchyRecord('churches', id, resource.data);
      allow create, update: if isSuperAdmin()
        || unionAdminForCreateUpdate('churches', id)
        || conferenceAdminForCreateUpdate('churches', id)
        || districtAdminForCreateUpdate('churches', id);
      allow delete: if isSuperAdmin()
        || unionAdminForDelete('churches', id)
        || conferenceAdminForDelete('churches', id)
        || districtAdminForDelete('churches', id);
    }

    // Legacy platform curriculum remains available only when explicitly published.
    match /curricula/discover/languages/{language} {
      allow get, list: if isAdmin()
        || (resource.data.get('published', false) == true && resource.data.get('archived', false) != true);
      allow create, update, delete: if canEditCurriculum();
    }
    match /curricula/discover/languages/{language}/lessons/{lessonId} {
      allow get, list: if get(/databases/$(database)/documents/curricula/discover/languages/$(language)).data.get('published', false) == true;
      allow create, update, delete: if canEditCurriculum();
    }

    // Legacy alternate curriculum documents are platform-managed.
    match /curriculum/{guideId} {
      allow get, list: if isAdmin() || resource.data.get('published', false) == true;
      allow create, update, delete: if canEditCurriculum();
    }

    // User profiles.
    match /users/{uid} {
      // Personal settings belong only to the authenticated account.
      // They cannot change roles, organization membership, privileges, ownership,
      // progress, assessment results, or any other authoritative record.
      match /settings/{settingId} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'theme', 'language', 'notifications', 'accessibility', 'privacy', 'studyPreferences', 'updatedAt'
          ]);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'theme', 'language', 'notifications', 'accessibility', 'privacy', 'studyPreferences', 'updatedAt'
          ]);
        allow delete: if isOwner(uid);
      }


      allow get: if signedIn() && (
        request.auth.uid == uid
        || isSuperAdmin()
        || (
          canManageOrg(organizationIdForUser())
          && resource.data.get('organizationId','') == organizationIdForUser()
        )
        || canManageHierarchyUser(resource.data)
      );
      allow list: if isSuperAdmin()
        || (
          canManageOrg(organizationIdForUser())
          && resource.data.get('organizationId','') == organizationIdForUser()
        )
        || canManageHierarchyUser(resource.data);

      allow create: if canCreateOwnProfile();
      allow update: if isSuperAdmin() || canUpdateOwnProfile();
      allow delete: if isSuperAdmin();

      match /progress/{recordId} {
        allow get, list: if signedIn()
          && (
            request.auth.uid == uid
            || (
              isAdmin()
              && userDoc().data.get('organizationId','') != ''
              && userDoc().data.get('organizationId','') == get(/databases/$(database)/documents/users/$(uid)).data.get('organizationId','')
            )
            || canManageHierarchyUser(get(/databases/$(database)/documents/users/$(uid)).data)
          );

        allow create: if isOwner(uid)
          && recordId == uid
          && validProgress(uid);

        allow update, delete: if false;
      }
    }

    // Prayer requests remain private to their candidate and administrators.
    // Prayer requests are private to their author and visible to authorized
    // organisation/hierarchy ministry administrators within their scope.
    match /prayerRequests/{id} {
      allow get: if signedIn()
        && (
          resource.data.candidateId == request.auth.uid
          || (
            isAdmin()
            && (
              isSuperAdmin()
              || resource.data.get('organizationId','') == organizationIdForUser()
              || hierarchyOrganizationScope(resource.data.get('organizationId',''))
            )
          )
        );

      allow list: if signedIn() && (
        resource.data.candidateId == request.auth.uid
        || (
          isAdmin()
          && (
            isSuperAdmin()
            || resource.data.get('organizationId','') == organizationIdForUser()
            || hierarchyOrganizationScope(resource.data.get('organizationId',''))
          )
        )
        || (
          isOrgMember(organizationIdForUser())
          && resource.data.get('organizationId','') == organizationIdForUser()
          && resource.data.get('isPrivate',false) != true
        )
      );

      allow create: if signedIn()
        && request.resource.data.candidateId == request.auth.uid
        && request.resource.data.get('organizationId','') == organizationIdForUser()
        && isOrgMember(organizationIdForUser());

      allow update: if signedIn()
        && (
          (
            resource.data.candidateId == request.auth.uid
            && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
            && request.resource.data.candidateId == request.auth.uid
          )
          || (
            isAdmin()
            && (
              isSuperAdmin()
              || hierarchyOrganizationScope(resource.data.get('organizationId',''))
              || resource.data.get('organizationId','') == organizationIdForUser()
            )
            && request.resource.data.get('organizationId','') == resource.data.get('organizationId','')
            && request.resource.data.candidateId == resource.data.candidateId
          )
        );

      allow delete: if signedIn()
        && (
          resource.data.candidateId == request.auth.uid
          || (
            isAdmin()
            && (
              isSuperAdmin()
              || hierarchyOrganizationScope(resource.data.get('organizationId',''))
              || resource.data.get('organizationId','') == organizationIdForUser()
            )
          )
        );
    }

    
    match /assessmentAttempts/{id} {
      allow get, list: if signedIn() && (
        resource.data.get('candidateId', resource.data.get('userId', '')) == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // Question-level aggregates are operational analytics, not learner-owned data.
    match /questionPerformance/{id} {
      allow get, list: if isAdmin() || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Learners may see their own graduation request/status, but cannot approve or
    // alter the authoritative workflow directly from the client.
    match /graduationRequests/{id} {
      allow get, list: if signedIn() && (
        resource.data.get('candidateId', '') == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // Certificate records are readable by the certificate holder and authorized
    // organization/platform administrators. Issuance and mutation remain server-side.
    match /certificates/{id} {
      allow get, list: if signedIn() && (
        resource.data.get('candidateId', '') == request.auth.uid
        || isSuperAdmin()
        || (isOrgMember(organizationIdForUser()) && resource.data.get('organizationId', '') == organizationIdForUser() && isAdmin())
        || canViewHierarchyCertificate(resource.data)
      );
      allow create, update, delete: if false;
    }

    // Notifications are private to the recipient, with administrator oversight
    // only within the recipient's organization.
    match /notifications/{id} {
      allow get, list: if signedIn() && (
        resource.data.get('userId', resource.data.get('uid', '')) == request.auth.uid
        || (isAdmin() && resource.data.get('organizationId', '') == organizationIdForUser())
      );
      allow create, update, delete: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
