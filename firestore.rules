rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasUserProfile() ? userDoc().data.get('role', 'student') : 'student';
    }

    function isSuperAdmin() {
      return signedIn() && role() == 'super_admin';
    }

    function isAdmin() {
      return signedIn() && role() in [
        'super_admin',
        'union_admin',
        'conference_admin',
        'district_admin',
        'church_admin'
      ];
    }

    function canEditCurriculum() {
      return isAdmin() && (
        role() == 'super_admin' ||
        userDoc().data.get('privileges', {}).get('editor', false) == true
      );
    }

    function validProgress(uid) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'ownerUid', 'language', 'lessonId', 'revision',
          'answers', 'practiceScore', 'status', 'submittedAt'
        ])
        && d.keys().hasOnly([
          'ownerUid', 'language', 'lessonId', 'revision',
          'answers', 'practiceScore', 'status', 'submittedAt'
        ])
        && d.ownerUid == uid
        && d.language is string
        && d.lessonId is string
        && d.revision is string
        && d.status == 'practice_unverified'
        && d.practiceScore is number
        && d.practiceScore >= 0
        && d.practiceScore <= 100
        && d.answers is list
        && d.answers.size() == 5
        && d.submittedAt == request.time;
    }

    function canCreateOwnProfile() {
      return signedIn()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.get('role', 'student') == 'student';
    }

    function canUpdateOwnProfile() {
      return signedIn()
        && request.auth.uid == resource.data.uid
        && request.resource.data.get('role', 'student') == resource.data.get('role', 'student')
        && request.resource.data.get('adminNodeType', null) == resource.data.get('adminNodeType', null)
        && request.resource.data.get('adminNodeId', null) == resource.data.get('adminNodeId', null)
        && request.resource.data.get('privileges', {}) == resource.data.get('privileges', {})
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'phoneNumber',
          'photoURL',
          'information',
          'preferences',
          'updatedAt'
        ]);
    }

    function canManageUserDocument() {
      return isSuperAdmin();
    }

    function unionAdminForCreateUpdate() {
      return role() == 'union_admin'
        && request.resource.data.get('unionId', '') == userDoc().data.get('adminNodeId', '');
    }

    function unionAdminForDelete() {
      return role() == 'union_admin'
        && resource.data.get('unionId', '') == userDoc().data.get('adminNodeId', '');
    }

    function conferenceAdminForCreateUpdate() {
      return role() == 'conference_admin'
        && request.resource.data.get('conferenceId', '') == userDoc().data.get('adminNodeId', '');
    }

    function conferenceAdminForDelete() {
      return role() == 'conference_admin'
        && resource.data.get('conferenceId', '') == userDoc().data.get('adminNodeId', '');
    }

    function districtAdminForCreateUpdate() {
      return role() == 'district_admin'
        && request.resource.data.get('districtId', '') == userDoc().data.get('adminNodeId', '');
    }

    function districtAdminForDelete() {
      return role() == 'district_admin'
        && resource.data.get('districtId', '') == userDoc().data.get('adminNodeId', '');
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if canCreateOwnProfile();
      allow update: if canManageUserDocument() || canUpdateOwnProfile();
      allow delete: if isSuperAdmin();

      match /progress/{recordId} {
        allow get, list: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if request.auth.uid == uid && recordId == uid && validProgress(uid);
        allow update, delete: if false;
      }
    }

    match /curricula/discover/languages/{language} {
      allow get, list: if signedIn();
      allow create, update, delete: if canEditCurriculum();

      match /lessons/{lessonId} {
        allow get, list: if signedIn();
        allow create, update, delete: if canEditCurriculum();
      }
    }

    // Required for the web app's collectionGroup('lessons') query.
    match /{path=**}/lessons/{lessonId} {
      allow get, list: if signedIn();
      allow create, update, delete: if canEditCurriculum();
    }

    match /system/settings {
      allow get: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /languages/{language} {
      allow get: if signedIn() && (resource.data.get('enabled', false) == true || isAdmin());
      allow list: if isAdmin() || (signedIn() && resource.data.get('enabled', false) == true);
      allow create, update, delete: if isAdmin();
    }

    match /translations/{language} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /unions/{id} {
      allow get, list: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /conferences/{id} {
      allow get, list: if signedIn();
      allow create, update: if isSuperAdmin() || unionAdminForCreateUpdate();
      allow delete: if isSuperAdmin() || unionAdminForDelete();
    }

    match /districts/{id} {
      allow get, list: if signedIn();
      allow create, update: if isSuperAdmin() || conferenceAdminForCreateUpdate();
      allow delete: if isSuperAdmin() || conferenceAdminForDelete();
    }

    match /churches/{id} {
      allow get, list: if signedIn();
      allow create, update: if isSuperAdmin() || districtAdminForCreateUpdate();
      allow delete: if isSuperAdmin() || districtAdminForDelete();
    }

    match /announcements/{id} {
      allow get: if signedIn() && (resource.data.get('published', false) == true || isAdmin());
      allow list: if isAdmin() || (signedIn() && resource.data.get('published', false) == true);
      allow create, update, delete: if isAdmin();
    }

    match /books/{id} {
      allow get: if signedIn() && (resource.data.get('published', false) == true || isAdmin());
      allow list: if isAdmin() || (signedIn() && resource.data.get('published', false) == true);
      allow create, update, delete: if isAdmin();
    }

    match /prayerRequests/{id} {
      allow get: if signedIn() && (
        resource.data.candidateId == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin() || (signedIn() && resource.data.candidateId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.candidateId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.candidateId == request.auth.uid || isAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    match /radioBroadcasts/{id} {
      allow get: if signedIn() && (resource.data.get('published', false) == true || isAdmin());
      allow list: if isAdmin() || (signedIn() && request.query.where('published', '==', true));
      allow create, update, delete: if isAdmin();
    }

    // Explicit default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
