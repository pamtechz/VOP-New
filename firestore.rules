rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'student';
    }

    function validProgress(uid) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'ownerUid', 'language', 'lessonId', 'revision',
          'answers', 'practiceScore', 'status', 'submittedAt'
        ])
        && d.keys().hasOnly([
          'ownerUid', 'language', 'lessonId', 'revision',
          'answers', 'practiceScore', 'status', 'submittedAt'
        ])
        && d.ownerUid == uid
        && d.language is string && d.language.matches('[a-z]{2,3}(-[a-z0-9]{2,8})*')
        && d.lessonId is string && d.lessonId.matches('[A-Za-z0-9_-]{1,80}')
        && d.revision is string && d.revision.matches('[a-f0-9]{64}')
        && d.status == 'practice_unverified'
        && d.practiceScore is number && d.practiceScore >= 0 && d.practiceScore <= 100
        && d.answers is list && d.answers.size() == 5
        && d.answers[0] is int && d.answers[0] >= 0 && d.answers[0] <= 5
        && d.answers[1] is int && d.answers[1] >= 0 && d.answers[1] <= 5
        && d.answers[2] is int && d.answers[2] >= 0 && d.answers[2] <= 5
        && d.answers[3] is int && d.answers[3] >= 0 && d.answers[3] <= 5
        && d.answers[4] is int && d.answers[4] >= 0 && d.answers[4] <= 5
        && d.submittedAt == request.time;
    }

    // Public application configuration and published ministry content.
    match /system/settings {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /languages/{languageId} {
      allow get, list: if resource.data.enabled == true;
      allow write: if isAdmin();
    }

    match /translations/{translationId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow get, list: if resource.data.published == true;
      allow write: if isAdmin();
    }

    match /books/{bookId} {
      allow get, list: if resource.data.published == true;
      allow write: if isAdmin();
    }

    match /radioBroadcasts/{broadcastId} {
      allow get, list: if resource.data.published == true;
      allow write: if isAdmin();
    }

    // Organization references are public content; mutations remain server-authorized.
    match /unions/{unionId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /conferences/{conferenceId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /districts/{districtId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /churches/{churchId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Lessons remain protected and are served only to authenticated learners/admins.
    match /{path=**}/lessons/{lessonId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;

      match /progress/{recordId} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid) && recordId == uid && validProgress(uid);
        allow update, delete: if false;
      }
    }

    // All other paths are implicitly denied.
  }
}
