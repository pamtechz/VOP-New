rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasUserProfile()
        ? userDoc().data.get('role', 'student')
        : 'student';
    }

    function isSuperAdmin() {
      return signedIn() && role() == 'super_admin';
    }

    function isAdmin() {
      return signedIn() && role() in [
        'super_admin',
        'union_admin',
        'conference_admin',
        'district_admin',
        'church_admin'
      ];
    }

    function organizationIdForUser() {
      return hasUserProfile() ? userDoc().data.get('organizationId', '') : '';
    }

    function isOrgMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('active', false) == true;
    }

    function orgRole(orgId) {
      return isOrgMember(orgId)
        ? get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', 'viewer')
        : '';
    }

    function canManageOrg(orgId) {
      return isSuperAdmin() || (
        isOrgMember(orgId)
        && orgRole(orgId) in ['owner', 'admin']
      );
    }

    function canEditOrgContent(orgId) {
      return isSuperAdmin() || (
        isOrgMember(orgId)
        && orgRole(orgId) in ['owner', 'admin', 'editor']
      );
    }

    function orgDataMatches(orgId, data) {
      return data.get('organizationId', '') == orgId
        || data.get('ownerOrganizationId', '') == orgId;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function canEditCurriculum() {
      return isAdmin() && (
        role() == 'super_admin' ||
        userDoc().data.get('privileges', {}).get('editor', false) == true
      );
    }

    function validProgress(uid) {
      let d = request.resource.data;

      return d.keys().hasAll([
          'ownerUid',
          'language',
          'lessonId',
          'revision',
          'answers',
          'practiceScore',
          'status',
          'submittedAt'
        ])
        && d.keys().hasOnly([
          'ownerUid',
          'language',
          'lessonId',
          'revision',
          'answers',
          'practiceScore',
          'status',
          'submittedAt'
        ])
        && d.ownerUid == uid
        && d.language is string
        && d.language.matches('[a-z]{2,3}(-[a-z0-9]{2,8})*')
        && d.lessonId is string
        && d.lessonId.matches('[A-Za-z0-9_-]{1,80}')
        && d.revision is string
        && d.revision.matches('[a-f0-9]{64}')
        && d.status == 'practice_unverified'
        && d.practiceScore is number
        && d.practiceScore >= 0
        && d.practiceScore <= 100
        && d.answers is list
        && d.answers.size() == 5
        && d.answers[0] is int
        && d.answers[0] >= 0
        && d.answers[0] <= 5
        && d.answers[1] is int
        && d.answers[1] >= 0
        && d.answers[1] <= 5
        && d.answers[2] is int
        && d.answers[2] >= 0
        && d.answers[2] <= 5
        && d.answers[3] is int
        && d.answers[3] >= 0
        && d.answers[3] <= 5
        && d.answers[4] is int
        && d.answers[4] >= 0
        && d.answers[4] <= 5
        && d.submittedAt == request.time;
    }

    function canCreateOwnProfile() {
      return signedIn()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.get('role', 'student') == 'student';
    }

    function canUpdateOwnProfile() {
      return signedIn()
        && request.auth.uid == resource.data.uid
        && request.resource.data.get('role', 'student')
            == resource.data.get('role', 'student')
        && request.resource.data.get('adminNodeType', null)
            == resource.data.get('adminNodeType', null)
        && request.resource.data.get('adminNodeId', null)
            == resource.data.get('adminNodeId', null)
        && request.resource.data.get('privileges', {})
            == resource.data.get('privileges', {})
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'phoneNumber',
            'photoURL',
            'information',
            'preferences',
            'updatedAt'
          ]);
    }

    function unionAdminForCreateUpdate() {
      return role() == 'union_admin'
        && request.resource.data.get('unionId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    function unionAdminForDelete() {
      return role() == 'union_admin'
        && resource.data.get('unionId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    function conferenceAdminForCreateUpdate() {
      return role() == 'conference_admin'
        && request.resource.data.get('conferenceId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    function conferenceAdminForDelete() {
      return role() == 'conference_admin'
        && resource.data.get('conferenceId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    function districtAdminForCreateUpdate() {
      return role() == 'district_admin'
        && request.resource.data.get('districtId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    function districtAdminForDelete() {
      return role() == 'district_admin'
        && resource.data.get('districtId', '')
            == userDoc().data.get('adminNodeId', '');
    }

    // Platform configuration remains controlled by the VOP Super Admin.
    match /system/settings {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    // First-class SaaS organizations and memberships.
    match /organizations/{organizationId} {
      allow get: if isSuperAdmin() || isOrgMember(organizationId);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || canManageOrg(organizationId);
      allow delete: if isSuperAdmin();

      match /members/{uid} {
        allow get: if isSuperAdmin() || uid == request.auth.uid || canManageOrg(organizationId);
        allow list: if isSuperAdmin() || canManageOrg(organizationId);
        allow create, update: if isSuperAdmin() || (canManageOrg(organizationId) && uid != request.auth.uid);
        allow delete: if isSuperAdmin() || (canManageOrg(organizationId) && uid != request.auth.uid);
      }

      match /settings/{settingId} {
        allow get: if isSuperAdmin() || isOrgMember(organizationId);
        allow list: if false;
        allow create, update, delete: if canManageOrg(organizationId);
      }

      match /audit/{entryId} {
        allow get, list: if isSuperAdmin() || canManageOrg(organizationId);
        allow create: if isSuperAdmin() || isOrgMember(organizationId);
        allow update, delete: if false;
      }
    }

    // Tenant-owned guides and lessons. Canonical editing never transfers through sharing.
    match /guides/{guideId} {
      allow get: if isSuperAdmin()
        || (isOrgMember(resource.data.organizationId) && resource.data.get('organizationId','') == organizationIdForUser())
        || (resource.data.get('sharingScope','private') == 'shared' && resource.data.get('published',false) == true);
      allow list: if isSuperAdmin()
        || (isOrgMember(organizationIdForUser()) && resource.data.get('organizationId','') == organizationIdForUser())
        || (resource.data.get('sharingScope','private') == 'shared' && resource.data.get('published',false) == true);
      allow create: if isSuperAdmin() || (
        request.resource.data.get('organizationId','') == organizationIdForUser()
        && canEditOrgContent(organizationIdForUser())
      );
      allow update, delete: if isSuperAdmin() || (
        resource.data.get('organizationId','') == organizationIdForUser()
        && canEditOrgContent(organizationIdForUser())
      );

      match /lessons/{lessonId} {
        allow get: if isSuperAdmin()
          || (isOrgMember(organizationIdForUser()) && get(/databases/$(database)/documents/guides/$(guideId)).data.get('organizationId','') == organizationIdForUser())
          || (get(/databases/$(database)/documents/guides/$(guideId)).data.get('sharingScope','private') == 'shared'
              && get(/databases/$(database)/documents/guides/$(guideId)).data.get('published',false) == true
              && resource.data.get('sharingScope','shared') == 'shared'
              && resource.data.get('published',false) == true);
        allow list: if isSuperAdmin()
          || (isOrgMember(organizationIdForUser()) && get(/databases/$(database)/documents/guides/$(guideId)).data.get('organizationId','') == organizationIdForUser())
          || (get(/databases/$(database)/documents/guides/$(guideId)).data.get('sharingScope','private') == 'shared'
              && get(/databases/$(database)/documents/guides/$(guideId)).data.get('published',false) == true
              && resource.data.get('sharingScope','shared') == 'shared'
              && resource.data.get('published',false) == true);
        allow create: if isSuperAdmin() || (
          get(/databases/$(database)/documents/guides/$(guideId)).data.get('organizationId','') == organizationIdForUser()
          && canEditOrgContent(organizationIdForUser())
          && request.resource.data.get('ownerOrganizationId','') == organizationIdForUser()
        );
        allow update, delete: if isSuperAdmin() || (
          get(/databases/$(database)/documents/guides/$(guideId)).data.get('organizationId','') == organizationIdForUser()
          && canEditOrgContent(organizationIdForUser())
          && resource.data.get('ownerOrganizationId','') == organizationIdForUser()
        );
      }
    }

    // Reusable quiz library.
    match /quizzes/{quizId} {
      allow get: if isSuperAdmin()
        || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser()))
        || (resource.data.get('sharingScope','private') == 'shared' && resource.data.get('published',false) == true);
      allow list: if isSuperAdmin()
        || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser()))
        || (resource.data.get('sharingScope','private') == 'shared' && resource.data.get('published',false) == true);
      allow create: if isSuperAdmin() || (
        request.resource.data.get('organizationId','') == organizationIdForUser()
        && canEditOrgContent(organizationIdForUser())
      );
      allow update, delete: if isSuperAdmin() || (
        resource.data.get('ownerOrganizationId','') == organizationIdForUser()
        && canEditOrgContent(organizationIdForUser())
      );
    }

    // Tenant-owned operational records. Published shared records remain publicly readable.
    match /announcements/{id} {
      allow get, list: if isSuperAdmin()
        || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser()))
        || resource.data.get('published',false) == true;
      allow create: if isSuperAdmin() || (
        request.resource.data.get('organizationId','') == organizationIdForUser()
        && canManageOrg(organizationIdForUser())
      );
      allow update, delete: if isSuperAdmin() || (
        resource.data.get('organizationId','') == organizationIdForUser()
        && canManageOrg(organizationIdForUser())
      );
    }

    match /books/{id} {
      allow get, list: if isSuperAdmin()
        || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser()))
        || resource.data.get('published',false) == true;
      allow create, update, delete: if isSuperAdmin() || (
        request.resource.data.get('organizationId','') == organizationIdForUser()
        && canManageOrg(organizationIdForUser())
      );
    }

    match /radioBroadcasts/{id} {
      allow get, list: if isSuperAdmin()
        || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser()))
        || resource.data.get('published',false) == true;
      allow create, update, delete: if isSuperAdmin() || (
        request.resource.data.get('organizationId','') == organizationIdForUser()
        && canManageOrg(organizationIdForUser())
      );
    }

    match /languages/{languageId} {
      allow get, list: if isSuperAdmin()
        || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser()))
        || resource.data.get('enabled',false) == true;
      allow create, update, delete: if isSuperAdmin() || (
        request.resource.data.get('organizationId','') == organizationIdForUser()
        && canManageOrg(organizationIdForUser())
      );
    }

    match /translations/{languageId} {
      allow get, list: if isSuperAdmin()
        || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser()));
      allow create, update, delete: if isSuperAdmin() || (
        request.resource.data.get('organizationId','') == organizationIdForUser()
        && canManageOrg(organizationIdForUser())
      );
    }

    // Platform certification configuration.
    match /system/certification {
      allow get: if resource.data.get('enabled', false) == true || isSuperAdmin();
      allow list: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    // Organization reference data remains platform-managed.
    match /unions/{id} {
      allow get, list: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }
    match /conferences/{id} {
      allow get, list: if signedIn();
      allow create, update: if isSuperAdmin() || unionAdminForCreateUpdate();
      allow delete: if isSuperAdmin() || unionAdminForDelete();
    }
    match /districts/{id} {
      allow get, list: if signedIn();
      allow create, update: if isSuperAdmin() || conferenceAdminForCreateUpdate();
      allow delete: if isSuperAdmin() || conferenceAdminForDelete();
    }
    match /churches/{id} {
      allow get, list: if signedIn();
      allow create, update: if isSuperAdmin() || districtAdminForCreateUpdate();
      allow delete: if isSuperAdmin() || districtAdminForDelete();
    }

    // Legacy platform curriculum remains available only when explicitly published.
    match /curricula/discover/languages/{language} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.get('published', false) == true && resource.data.get('archived', false) != true);
      allow create, update, delete: if canEditCurriculum();
    }
    match /curricula/discover/languages/{language}/lessons/{lessonId} {
      allow get, list: if signedIn() && get(/databases/$(database)/documents/curricula/discover/languages/$(language)).data.get('published', false) == true;
      allow create, update, delete: if canEditCurriculum();
    }

    // Legacy alternate curriculum documents are platform-managed.
    match /curriculum/{guideId} {
      allow get, list: if isAdmin() || resource.data.get('published', false) == true;
      allow create, update, delete: if canEditCurriculum();
    }

    // User profiles.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin() || (resource.data.get('organizationId','') == organizationIdForUser() && isOrgMember(organizationIdForUser())));
      allow list: if isSuperAdmin() || (isOrgMember(organizationIdForUser()) && resource.data.get('organizationId','') == organizationIdForUser());

      allow create: if canCreateOwnProfile();
      allow update: if isSuperAdmin() || canUpdateOwnProfile();
      allow delete: if isSuperAdmin();

      match /progress/{recordId} {
        allow get, list: if signedIn()
          && (request.auth.uid == uid || isAdmin());

        allow create: if isOwner(uid)
          && recordId == uid
          && validProgress(uid);

        allow update, delete: if false;
      }
    }

    // Prayer requests remain private to their candidate and administrators.
    match /prayerRequests/{id} {
      allow get: if signedIn()
        && (
          resource.data.candidateId == request.auth.uid
          || isAdmin()
        );

      allow list: if signedIn() && (isSuperAdmin() || isAdmin() || resource.data.candidateId == request.auth.uid || resource.data.get('organizationId','') == organizationIdForUser());

      allow create: if signedIn()
        && (request.resource.data.candidateId == request.auth.uid || (isOrgMember(organizationIdForUser()) && request.resource.data.get('organizationId','') == organizationIdForUser()));

      allow update: if signedIn()
        && (
          resource.data.candidateId == request.auth.uid
          || isAdmin()
        );

      allow delete: if isSuperAdmin();
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
