rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid))
        : null;
    }

    function isSuperAdmin() {
      return signedIn() && userDoc().data.role == 'super_admin';
    }

    function isAdmin() {
      return signedIn()
        && userDoc().data.role in [
          'super_admin',
          'union_admin',
          'conference_admin',
          'district_admin',
          'church_admin'
        ];
    }

    function canEditCurriculum() {
      return isAdmin() && (
        userDoc().data.role == 'super_admin'
        || userDoc().data.privileges.editor == true
      );
    }

    function validProgress(uid) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'ownerUid', 'language', 'lessonId', 'revision',
          'answers', 'practiceScore', 'status', 'submittedAt'
        ])
        && d.keys().hasOnly([
          'ownerUid', 'language', 'lessonId', 'revision',
          'answers', 'practiceScore', 'status', 'submittedAt'
        ])
        && d.ownerUid == uid
        && d.language is string
        && d.lessonId is string
        && d.revision is string
        && d.status == 'practice_unverified'
        && d.practiceScore is number
        && d.practiceScore >= 0
        && d.practiceScore <= 100
        && d.answers is list
        && d.answers.size() == 5
        && d.submittedAt == request.time;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid || isAdmin();
      allow delete: if isSuperAdmin();

      match /progress/{recordId} {
        allow get, list: if request.auth.uid == uid || isAdmin();
        allow create: if request.auth.uid == uid && recordId == uid && validProgress(uid);
        allow update, delete: if false;
      }
    }

    match /curricula/discover/languages/{language} {
      allow get, list: if signedIn();
      allow create, update, delete: if canEditCurriculum();

      match /lessons/{lessonId} {
        allow get, list: if signedIn();
        allow create, update, delete: if canEditCurriculum();
      }
    }

    match /{path=**}/lessons/{lessonId} {
      allow get, list: if signedIn();
      allow create, update, delete: if canEditCurriculum();
    }

    match /system/settings {
      allow get: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /translations/{language} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /unions/{id} {
      allow get, list: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /conferences/{id} {
      allow get, list: if signedIn();
      allow create, update, delete: if isSuperAdmin() || (
        userDoc().data.role == 'union_admin'
        && request.resource.data.unionId == userDoc().data.adminNodeId
      );
    }

    match /districts/{id} {
      allow get, list: if signedIn();
      allow create, update, delete: if isSuperAdmin() || (
        userDoc().data.role == 'conference_admin'
        && request.resource.data.conferenceId == userDoc().data.adminNodeId
      );
    }

    match /churches/{id} {
      allow get, list: if signedIn();
      allow create, update, delete: if isSuperAdmin() || (
        userDoc().data.role == 'district_admin'
        && request.resource.data.districtId == userDoc().data.adminNodeId
      );
    }

    match /announcements/{id} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /books/{id} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /prayerRequests/{id} {
      allow get: if signedIn() && (
        resource.data.candidateId == request.auth.uid || isAdmin()
      );
      allow list: if signedIn();
      allow create: if signedIn() && request.resource.data.candidateId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.candidateId == request.auth.uid || isAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    match /radioBroadcasts/{id} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
