# Optional LOCAL overrides only; do not commit a populated .env.
# Recommended: link to Vercel and use .\run_vop.ps1 -Mode Emulator -UseVercelEnv
# Web Firebase app IDs are NOT Android app IDs.
# Without this file, VOP reads its public package-matched Android registration.
# Set values only when overriding the registered Android config.
VOP_API_BASE_URL=
VOP_FIREBASE_API_KEY=
VOP_FIREBASE_ANDROID_APP_ID=
VOP_FIREBASE_SENDER_ID=
VOP_FIREBASE_PROJECT_ID=
VOP_GOOGLE_WEB_CLIENT_ID=
