{
  "rewrites": [
    {
      "source": "/api/public-catalog",
      "destination": "/api/admin?__vopRoute=public-catalog"
    },
    {
      "source": "/api/mobile",
      "destination": "/api/admin?__vopRoute=mobile"
    },
    {
      "source": "/api/account",
      "destination": "/api/admin?__vopRoute=account"
    },
    {
      "source": "/api/account-lifecycle-cron",
      "destination": "/api/admin?__vopRoute=account&__vopAccountRoute=lifecycle-cron"
    },
    {
      "source": "/api/health",
      "destination": "/api/admin?__vopRoute=health"
    },
    {
      "source": "/api/admin/:route*",
      "destination": "/api/admin?__vopRoute=:route*"
    },
    {
      "source": "/api/payments/:route*",
      "destination": "/api/payments?__vopPaymentRoute=:route*"
    },
    {
      "source": "/classic/editor",
      "destination": "/index.html"
    },
    {
      "source": "/classic/",
      "destination": "/classic/index.html"
    },
    {
      "source": "/classic/((?!.*[.][A-Za-z0-9]{1,8}$).*)",
      "destination": "/classic/index.html"
    },
    {
      "source": "/((?!api(?:/|$)|\\.well-known(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/mentorship-cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/payments/reconcile-cron",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/account-lifecycle-cron",
      "schedule": "30 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/classic/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/classic/flutter_bootstrap.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "npm run build && bash scripts/build-unified-web.sh",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/classic",
      "destination": "/classic/",
      "permanent": true
    }
  ]
}
