{
  "name": "vop-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/verify-server-esm-imports.mjs && tsc -b && vite build",
    "typecheck:serverless": "tsc -p tsconfig.serverless.json",
    "verify:content": "node scripts/generate-snapshots.js && node --test tests/ingestion.test.mjs tests/snapshots.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts tests/mtnMomoProvider.test.mjs tests/airtelMoneyProvider.test.mjs tests/productionAssets.test.mjs tests/pwa.test.mjs tests/serverlessRouting.test.mjs tests/apiRuntime.test.mjs tests/localizationFlow.test.mjs",
    "lint": "oxlint src api api_handlers server scripts tests vite.config.ts",
    "lint:legacy": "oxlint src",
    "preview": "vite preview",
    "verify:architecture": "node scripts/verify-vop-architecture.mjs",
    "inventory:ui-localization": "node scripts/inventory-ui-localization.mjs",
    "verify:rules": "firebase emulators:exec --only firestore --project demo-vop-security-rules \"node --test tests/firestoreRules.test.mjs\"",
    "migrate:plate-lessons": "node scripts/migrate-legacy-lessons-to-plate.mjs",
    "payments:mtn:provision-sandbox": "node scripts/mtn-momo-sandbox-provision.mjs",
    "verify:ui-localization": "node scripts/inventory-ui-localization.mjs --check",
    "verify:bundle-budget": "node scripts/verify-bundle-budget.mjs",
    "ops:firestore-restore": "node scripts/firestore-restore.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "verify:restore": "node scripts/verify-emulator-restore.mjs"
  },
  "dependencies": {
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/link": "53.0.0",
    "@platejs/list-classic": "53.0.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.47.0",
    "platejs": "53.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "15.34.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "@opentelemetry/core": "2.8.0",
    "@grpc/grpc-js": "1.14.5",
    "gaxios": {
      "uuid": "11.1.1"
    },
    "jwks-rsa": {
      "jose": "4.15.9"
    },
    "re2js": "2.8.7"
  },
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2"
}
